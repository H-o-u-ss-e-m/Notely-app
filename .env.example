# Notely — configuration (copier vers .env, ne JAMAIS committer .env)
# dev | staging | prod  (en prod : CORS https uniquement)
ENV=dev

# OBLIGATOIRE — aucune valeur par défaut. Remplacer USER / PASSWORD.
DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@localhost:5432/notely

# OBLIGATOIRE — >= 32 caractères. Générer avec :
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Origines autorisées (liste JSON ou séparées par des virgules). Jamais "*".
CORS_ORIGINS=["http://localhost:4200","http://127.0.0.1:4200"]

# Taille maximale d'un corps de requête (Mo)
MAX_REQUEST_BODY_MB=25

STORAGE_ROOT=storage
TROCR_MODEL=microsoft/trocr-base-handwritten
